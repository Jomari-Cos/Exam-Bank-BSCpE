{
  "entities": {
    "User": {
      "title": "User",
      "description": "Academic faculty, administrator, reviewer, or examiner account",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "email": { "type": "string", "maxLength": 200 },
        "role": { "type": "string", "enum": ["admin", "faculty", "reviewer", "examiner"] },
        "department": { "type": "string", "maxLength": 200 },
        "title": { "type": "string", "maxLength": 200 },
        "active": { "type": "boolean" },
        "avatarInitials": { "type": "string", "maxLength": 10 }
      },
      "required": ["id", "name", "email", "role", "active"]
    },
    "Course": {
      "title": "Course",
      "description": "BSCpE curriculum course and syllabus definitions",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "code": { "type": "string", "maxLength": 50 },
        "name": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 2000 },
        "credits": { "type": "number" },
        "yearLevel": { "type": "number" },
        "topics": { "type": "array" },
        "learningOutcomes": { "type": "array" }
      },
      "required": ["id", "code", "name", "category"]
    },
    "Question": {
      "title": "Question",
      "description": "Examination question across 11 formats with answers and rubric",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "courseId": { "type": "string", "maxLength": 128 },
        "courseCode": { "type": "string", "maxLength": 50 },
        "courseName": { "type": "string", "maxLength": 200 },
        "topic": { "type": "string", "maxLength": 200 },
        "type": { "type": "string", "maxLength": 50 },
        "question": { "type": "string", "maxLength": 20000 },
        "difficulty": { "type": "string", "enum": ["Easy", "Medium", "Hard"] },
        "learningOutcome": { "type": "string", "maxLength": 500 },
        "points": { "type": "number" },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 200 },
        "reviewerId": { "type": "string", "maxLength": 128 },
        "reviewerName": { "type": "string", "maxLength": 200 },
        "academicYear": { "type": "string", "maxLength": 50 },
        "semester": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["Draft", "Submitted", "Under Review", "Approved", "Published", "Archived"] },
        "dateCreated": { "type": "string", "maxLength": 50 },
        "dateModified": { "type": "string", "maxLength": 50 },
        "explanation": { "type": "string", "maxLength": 20000 }
      },
      "required": ["id", "courseId", "courseCode", "type", "question", "difficulty", "points", "authorId", "status"]
    },
    "Examination": {
      "title": "Examination",
      "description": "Compiled examination package with randomized versions and answer keys",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 300 },
        "courseId": { "type": "string", "maxLength": 128 },
        "courseCode": { "type": "string", "maxLength": 50 },
        "courseName": { "type": "string", "maxLength": 200 },
        "term": { "type": "string", "maxLength": 50 },
        "academicYear": { "type": "string", "maxLength": 50 },
        "semester": { "type": "string", "maxLength": 50 },
        "instructions": { "type": "string", "maxLength": 5000 },
        "timeLimitMinutes": { "type": "number" },
        "totalPoints": { "type": "number" },
        "questionCount": { "type": "number" },
        "selectedQuestionIds": { "type": "array" },
        "versions": { "type": "array" },
        "dateCreated": { "type": "string", "maxLength": 50 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 200 },
        "settings": { "type": "object" }
      },
      "required": ["id", "title", "courseId", "courseCode", "term", "versions"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "System security and action audit entry",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "timestamp": { "type": "string", "maxLength": 50 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 200 },
        "role": { "type": "string", "maxLength": 50 },
        "action": { "type": "string", "maxLength": 100 },
        "targetType": { "type": "string", "maxLength": 50 },
        "targetId": { "type": "string", "maxLength": 128 },
        "details": { "type": "string", "maxLength": 2000 }
      },
      "required": ["id", "timestamp", "userId", "userName", "action", "targetType"]
    },
    "SystemSettings": {
      "title": "SystemSettings",
      "description": "Global institutional parameters and term preferences",
      "type": "object",
      "properties": {
        "academicYear": { "type": "string", "maxLength": 50 },
        "currentSemester": { "type": "string", "maxLength": 50 },
        "gradingTerms": { "type": "array" },
        "institutionName": { "type": "string", "maxLength": 300 },
        "departmentName": { "type": "string", "maxLength": 300 },
        "defaultTimeLimitMinutes": { "type": "number" },
        "requireReviewBeforeExam": { "type": "boolean" },
        "minReviewersRequired": { "type": "number" }
      },
      "required": ["academicYear", "currentSemester", "institutionName", "departmentName"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user profiles, roles, and departmental permissions"
    },
    "/courses/{courseId}": {
      "schema": { "$ref": "#/entities/Course" },
      "description": "Stores curriculum courses, units, and syllabus topics"
    },
    "/questions/{questionId}": {
      "schema": { "$ref": "#/entities/Question" },
      "description": "Stores examination questions, answer keys, test cases, and reviews"
    },
    "/examinations/{examId}": {
      "schema": { "$ref": "#/entities/Examination" },
      "description": "Stores generated examination packages, versions, and answer sheets"
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Stores immutable audit trail of actions taken in the bank"
    },
    "/settings/global": {
      "schema": { "$ref": "#/entities/SystemSettings" },
      "description": "Stores global academic year, semester, and header templates"
    }
  }
}
